{
  "model": {
    "classifier_architecture": "LIDCClassifier \u2014 Encoder3D(stem->s1->s2->s3->s4->Pool->FC(256)) + head(Linear(256,128)->ReLU->Dropout(0.3)->Linear(128,64)->ReLU->Dropout(0.2)->Linear(64,n_cls))",
    "segmentation_architecture": "UNet3D \u2014 4-level encoder/decoder with skip connections, in_ch=in_channels",
    "channel_attention": "SEBlock (r=8) in each ResBlk",
    "spatial_attention": "CBAMSpatial (k=7) in each ResBlk",
    "num_classes": 3,
    "in_channels": 2,
    "embed_dim": 256,
    "class_names": [
      "Benign/Unknown",
      "Primary Lung Ca",
      "Metastatic"
    ]
  },
  "preprocessing": {
    "step_order": [
      "1. load_dicom_series(dicom_dir) -> (volume [Z,Y,X], spacing [Z,Y,X])",
      "2. _resample(vol, spacing, target_spacing)  [scipy.ndimage.zoom, order=1]",
      "3. _crop_pad(vol, target_shape)             [centre-crop or zero-pad]",
      "4. ch0 = _clip_norm(vol, hu_min, hu_max)   [standard window]",
      "5. ch1 = _clip_norm(vol, hu_lung_min, hu_lung_max) [lung window] \u2014 if use_dual_channel",
      "6. img = np.stack([ch0, ch1], axis=0) -> shape [2, Z, Y, X]",
      "7. mask from build_consensus_mask(patient_id, target_shape, target_spacing, clevel=0.5)"
    ],
    "target_spacing_zyx_mm": [
      2.0,
      1.0,
      1.0
    ],
    "target_shape_zyx_vox": [
      64,
      128,
      128
    ],
    "hu_min": -1000,
    "hu_max": 400,
    "hu_lung_min": -600,
    "hu_lung_max": 1500,
    "use_dual_channel": true,
    "image_channels": 2
  },
  "training": {
    "strategy": "StratifiedKFold(n_splits=5, shuffle=True, random_state=42)",
    "epochs": 40,
    "batch_size": 2,
    "optimizer": "AdamW(lr=0.0003, weight_decay=0.0001)",
    "scheduler": "CosineAnnealingLR(T_max=40, eta_min=1e-06)",
    "cls_loss": "FocalLoss(gamma=2.0) with class_weights",
    "class_weights": {
      "Benign/Unknown": 0.813729,
      "Primary Lung Ca": 1.187604,
      "Metastatic": 0.998667
    },
    "class_counts": {
      "Benign/Unknown": 54,
      "Primary Lung Ca": 37,
      "Metastatic": 44
    },
    "seg_loss": "DiceLoss",
    "seg_loss_weight": 0.3,
    "total_loss": "loss_cls + 0.3 * loss_seg",
    "patience": 8,
    "mixed_precision": true,
    "seed": 42
  },
  "inference": {
    "seg_threshold": 0.5,
    "cls_threshold_tuning": true,
    "num_classes": 3,
    "class_names": [
      "Benign/Unknown",
      "Primary Lung Ca",
      "Metastatic"
    ],
    "class_map": {
      "0": "Benign/Unknown (diagnosis 0 or 1)",
      "1": "Primary Lung Cancer (diagnosis 2)",
      "2": "Metastatic (diagnosis 3)"
    },
    "ensemble_strategy": "average softmax probabilities across folds, then argmax"
  },
  "label_source": {
    "file": "tcia-diagnosis-data-2012-04-20.xls",
    "column": "Diagnosis at the Patient Level\n0=Unknown\n1=benign or non-malignant disease\n2= malignant, primary lung cancer\n3 = malignant metastatic\n",
    "mapping": {
      "0": 0,
      "1": 0,
      "2": 1,
      "3": 2
    }
  },
