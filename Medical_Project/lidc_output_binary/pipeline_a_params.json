{
  "model": {
    "architecture": "FusionModel_A \u2014 ImgEnc_A(stem->l1->l2->l3->l4->Pool->LayerNorm->FC(256)) + TabEnc_A(FC->BN->ReLU->Dropout->FC(64)) + Classifier(FC(320->128->64->1))",
    "attention": "CBAM (SE channel + CBAMSpatial k=7) in ResBlk_A from l2 onward",
    "in_channels": 2,
    "embed_dim": 256,
    "dual_channel": true
  },
  "preprocessing": {
    "target_spacing": [
      2.0,
      1.0,
      1.0
    ],
    "target_shape": [
      64,
      128,
      128
    ],
    "hu_min": -1000,
    "hu_max": 400,
    "hu_lung_min": -600,
    "hu_lung_max": 1500,
    "channels": "ch0=standard HU window, ch1=lung HU window"
  },
  "training": {
    "strategy": "StratifiedKFold(n_splits=5, shuffle=True)",
    "loss": "BinaryFocalLoss(gamma=2.0, pos_weight=1.000)",
    "optimizer": "AdamW(lr=0.0002, weight_decay=0.0001)",
    "scheduler": "CosineAnnealingLR(T_max=30, eta_min=1e-06)",
    "grad_clip": 1.0,
    "patience": 8,
    "epochs": 30,
    "batch_size": 2,
    "mixed_precision": true
  },
  "inference": {
    "threshold_tuning": true,
    "ensemble_strategy": "average sigmoid probabilities across folds"
  },
